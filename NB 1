# --------------------------------------------------------------------------- setup


def setup_paths(data: Path) -> None:
    """Make `kickmix` and the verifier packages importable."""
    for p in (data / "kickmix", data / "verifiers", data):
        if p.exists() and str(p) not in sys.path:
            sys.path.insert(0, str(p))
    try:
        import kickmix  
        return
    except ImportError:
        pass
    for wheel_dir in (data / "kickmix", data):
        wheels = sorted(wheel_dir.rglob("kickmix*.whl")) if wheel_dir.exists() else []
        if wheels:
            os.system(f"{sys.executable} -m pip install -q --no-deps {wheels[0]}")
            break
    else:
        os.system(f"{sys.executable} -m pip install -q kickmix")
    import kickmix  


def find_file(name: str, data: Path) -> Path | None:
    """Locate a helper script by file name under the competition data or nearby."""
    for root in [data, *EXTRA_SEARCH_DIRS]:
        if not root.exists():
            continue
        direct = root / name
        if direct.is_file():
            return direct
        for dirpath, dirnames, filenames in os.walk(root):
            depth = Path(dirpath).relative_to(root).parts
            if len(depth) > 5:
                dirnames[:] = []
                continue
            if name in filenames:
                return Path(dirpath) / name
    return None


def load_module(name: str, data: Path, alias: str | None = None):
    path = find_file(name + ".py", data)
    if path is None:
        raise FileNotFoundError(f"cannot find {name}.py under {data} or the fallback directories")
    spec = importlib.util.spec_from_file_location(alias or name, path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[alias or name] = mod
    spec.loader.exec_module(mod)
    return mod


def import_dfthcsos(data: Path):
    """Import the `dfthcsos` verifier package (wherever it sits in the data)."""
    try:
        return importlib.import_module("dfthcsos.verify")
    except ImportError:
        pass
    for dirpath, dirnames, filenames in os.walk(data):
        if Path(dirpath).name == "dfthcsos" and "verify.py" in filenames:
            sys.path.insert(0, str(Path(dirpath).parent))
            return importlib.import_module("dfthcsos.verify")
        if len(Path(dirpath).relative_to(data).parts) > 5:
            dirnames[:] = []
    raise ImportError("dfthcsos package (verify.py + scoreinfra/) not found in the competition data")


def copy_if_exists(src: Path, dst: Path) -> bool:
    if src.exists():
        dst.parent.mkdir(parents=True, exist_ok=True)
        if src.is_dir():
            shutil.copytree(src, dst, dirs_exist_ok=True)
        else:
            shutil.copy2(src, dst)
        return True
    return False


# --------------------------------------------------------------------------- invsqrt


def invsqrt_estimate(nr, prec, drop: int, xs: np.ndarray, n_p: int, cap: float = 0.97):
    """Score estimate of a Precision (+ number of dropped low phase bits).

    The fixed-point model reproduces the circuit exactly (see nr_reference_circuit), so the
    simulated phase error is known in closed form.  Returns None if the error exceeds
    `cap` * tolerance anywhere on the domain, otherwise (score, info).
    """
    try:
        y = nr.fixed_point_model(n_p, prec, xs)
    except (OverflowError, ValueError):
        return None
    if drop:
        y = (y >> drop) << drop
    exact = 1.0 / np.sqrt(xs.astype(np.float64))
    err = np.abs(y / 2.0 ** prec.output_bits(n_p) - exact)  # turns
    tol = 2.0 ** -24 * exact
    if (err > cap * tol).any():
        return None
    margin = float((tol - err).min())
    circuit = build_nr(nr, prec, drop, n_p)
    st = circuit.operation_statistics()
    n_rot = st.num_z_pow(min_clifford_hierarchy_level=4)
    eps = math.pi * margin / max(n_rot, 1)
    t_cost = st.num_t_like + n_rot * (0.56 * math.log2(1 / eps) + 5.3)
    score = circuit.num_qubits * (st.num_toffoli_like + t_cost / 4)
    return score, dict(qubits=circuit.num_qubits, toffoli=int(st.num_toffoli_like), rotations=int(n_rot), eps=eps)


def build_nr(nr, prec, drop: int, n_p: int):
    """Reference NR circuit, skipping the `drop` lowest (negligible) phase bits."""
    original = nr._phase_by_bits

    def phase_by_bits(builder, y):
        f = len(y)
        with builder.mark("phase_by_bits"):
            for j in range(drop, f):
                builder.z_pow(y[j], Fraction(2) ** (j - f + 1))

    nr._phase_by_bits = phase_by_bits
    try:
        return nr.build_nr_circuit(n_p, prec=prec)
    finally:
        nr._phase_by_bits = original


def stage_invsqrt(args, data: Path, out: Path):
    import kickmix as km

    nr = load_module("nr_reference_circuit", data)
    inv = load_module("verify_submission_invsqrt", data)
    n_p = 10
    spec = inv.ProblemSpecInvSqrt.for_n_p(n_p)
    xs = np.arange(1, spec.max_x + 1, dtype=np.int64)

    best_p, best_d = nr.Precision(), 0
    best = invsqrt_estimate(nr, best_p, best_d, xs, n_p)
    log("invsqrt reference:", best)
    fields = ["delta_bits", "coef_bits", "square_bits", "product_bits", "result_bits"]
    improved = True
    while improved:
        improved = False
        for f in fields:
            for step in (-1, -2, -3, +1):
                cand = dataclasses.replace(best_p, **{f: getattr(best_p, f) + step})
                r = invsqrt_estimate(nr, cand, best_d, xs, n_p)
                if r and r[0] < best[0] - 1:
                    best, best_p, improved = r, cand, True
                    log(f"  {f}{step:+d} -> {best[0]:.0f}  {best[1]}")
        for step in (1, 2, 3):
            r = invsqrt_estimate(nr, best_p, best_d + step, xs, n_p)
            if r and r[0] < best[0] - 1:
                best, best_d, improved = r, best_d + step, True
                log(f"  drop {best_d} low phase bits -> {best[0]:.0f}")
    log("invsqrt tuned:", best_p, "drop", best_d, "est. score", f"{best[0]:.0f}", best[1])

    circuit = build_nr(nr, best_p, best_d, n_p)
    path = out / "invsqrt.kmb"
    circuit.to_file(str(path), format="kmb")
    SUMMARY["invsqrt"] = dict(precision=dataclasses.asdict(best_p), dropped_bits=best_d, estimated_score=best[0], **best[1])

    if args.invsqrt_shots_per_x:
        spec = dataclasses.replace(spec, shots_per_x=args.invsqrt_shots_per_x)
        res = inv.verify(km.Circuit.from_file(str(path), format="kmb"), spec, salt=args.salt, max_workers=args.workers)
        log("invsqrt verifier:", {k: res[k] for k in ("status", "score", "toffoli_equivalent", "num_qubits")})
        SUMMARY["invsqrt"]["verified_score"] = res["score"]
        ref = Path(data / "sample_submission" / "invsqrt.kmb")
        if ref.exists() and args.compare_sample:
            ref_res = inv.verify(km.Circuit.from_file(str(ref), format="kmb"), spec, salt=args.salt, max_workers=args.workers)
            SUMMARY["invsqrt"]["sample_score"] = ref_res["score"]
            if ref_res["score"] < res["score"]:
                log("sample invsqrt is better; keeping it")
                shutil.copy2(ref, path)


